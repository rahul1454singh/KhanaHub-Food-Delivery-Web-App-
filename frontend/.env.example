# ==============================================================================
# KhanaHub Frontend - Environment Variables Configuration
# ==============================================================================
# Add these variables in your Vercel Project Settings > Environment Variables:

# 1. Supabase Project URL & Anon Key (From Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Razorpay Public Key ID (From Razorpay Dashboard > Settings > API Keys)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
